{
  "expo": {
    "name": "Nuva",
    "slug": "nuva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nuva",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nuva.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Nuva needs camera access to scan your prescriptions.",
        "NSPhotoLibraryUsageDescription": "Nuva needs photo access to upload prescription images.",
        "NSMicrophoneUsageDescription": "Nuva needs microphone access so you can speak to the AI assistant."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "usesCleartextTraffic": true,
      "package": "com.nuva.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nuva needs access to your photos to upload prescription images.",
          "cameraPermission": "Nuva needs camera access to scan prescriptions."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Nuva needs microphone access so you can speak to the AI assistant."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "84e1fa70-f362-4c84-8df6-015f9cacb5c6"
      }
    },
    "owner": "prad1710s-organization"
  }
}
